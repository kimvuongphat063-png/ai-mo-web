<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.KidsGames" parent="Theme.AppCompat.Light.NoActionBar">
        <item name="colorPrimary">@color/teal</item>
        <item name="colorPrimaryDark">@color/teal_dark</item>
        <item name="colorAccent">@color/yellow</item>
        <item name="android:windowBackground">@color/cream</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:textColorPrimary">@color/ink</item>
        <item name="android:windowContentOverlay">@null</item>
    </style>

    <style name="KidsText.Title" parent="TextAppearance.AppCompat">
        <item name="android:textSize">28sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">@color/teal_dark</item>
    </style>

    <style name="KidsText.Body" parent="TextAppearance.AppCompat">
        <item name="android:textSize">16sp</item>
        <item name="android:textColor">@color/ink</item>
    </style>

    <style name="KidsText.Section" parent="TextAppearance.AppCompat">
        <item name="android:textSize">19sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">@color/teal_dark</item>
    </style>

    <style name="ParentButton" parent="Widget.AppCompat.Button.Colored">
        <item name="android:minHeight">52dp</item>
        <item name="android:textSize">15sp</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:paddingStart">18dp</item>
        <item name="android:paddingEnd">18dp</item>
        <item name="backgroundTint">@color/teal</item>
    </style>

    <style name="ParentButton.Secondary" parent="Widget.AppCompat.Button">
        <item name="android:minHeight">52dp</item>
        <item name="android:textSize">15sp</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:paddingStart">18dp</item>
        <item name="android:paddingEnd">18dp</item>
        <item name="android:textColor">@color/parent_secondary_text</item>
        <item name="backgroundTint">@color/parent_secondary_tint</item>
    </style>
</resources>
