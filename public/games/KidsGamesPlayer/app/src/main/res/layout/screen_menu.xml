<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <FrameLayout
        android:id="@+id/header"
        android:layout_width="match_parent"
        android:layout_height="@dimen/menu_header_height">

        <ImageView
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:importantForAccessibility="no"
            android:scaleType="centerCrop"
            android:src="@drawable/bg_sky" />

        <ImageView
            android:id="@+id/mascot_gi"
            android:layout_width="wrap_content"
            android:layout_height="96dp"
            android:layout_gravity="bottom|start"
            android:layout_marginStart="16dp"
            android:adjustViewBounds="true"
            android:importantForAccessibility="no"
            android:src="@drawable/mascot_gi_wave" />

        <TextView
            android:id="@+id/menu_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:layout_marginStart="96dp"
            android:layout_marginEnd="190dp"
            android:background="@drawable/bg_title_pill"
            android:gravity="center"
            android:paddingStart="28dp"
            android:paddingTop="8dp"
            android:paddingEnd="28dp"
            android:paddingBottom="8dp"
            android:text="@string/menu_title"
            android:textAppearance="@style/KidsText.Title" />

        <ImageView
            android:id="@+id/mascot_shi"
            android:layout_width="wrap_content"
            android:layout_height="90dp"
            android:layout_gravity="bottom|end"
            android:layout_marginEnd="140dp"
            android:adjustViewBounds="true"
            android:importantForAccessibility="no"
            android:src="@drawable/mascot_shi_wave" />

        <vn.family.kidsgamesplayer.ui.HoldButton
            android:id="@+id/parent_button"
            android:layout_width="wrap_content"
            android:layout_height="@dimen/parent_button_size"
            android:layout_gravity="top|end"
            android:layout_margin="10dp"
            android:background="@drawable/bg_parent_button"
            android:contentDescription="@string/cd_parent"
            android:drawablePadding="6dp"
            android:gravity="center_vertical"
            android:paddingStart="12dp"
            android:paddingEnd="14dp"
            android:text="@string/parent_button"
            android:textColor="@color/white"
            android:textSize="15sp"
            android:textStyle="bold" />
    </FrameLayout>

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/grid"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipToPadding="false"
            android:paddingStart="12dp"
            android:paddingTop="12dp"
            android:paddingEnd="12dp"
            android:paddingBottom="24dp"
            android:scrollbars="none" />

        <LinearLayout
            android:id="@+id/empty_state"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:visibility="gone">

            <ImageView
                android:layout_width="wrap_content"
                android:layout_height="180dp"
                android:adjustViewBounds="true"
                android:importantForAccessibility="no"
                android:src="@drawable/mascot_shi_puzzled" />

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="16dp"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/menu_empty_title"
                    android:textAppearance="@style/KidsText.Title" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:maxWidth="360dp"
                    android:text="@string/menu_empty_body"
                    android:textAppearance="@style/KidsText.Body" />
            </LinearLayout>
        </LinearLayout>

        <TextView
            android:id="@+id/menu_hint"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom|center_horizontal"
            android:layout_marginBottom="12dp"
            android:background="@drawable/bg_title_pill"
            android:paddingStart="16dp"
            android:paddingTop="8dp"
            android:paddingEnd="16dp"
            android:paddingBottom="8dp"
            android:text="@string/menu_back_hint"
            android:textAppearance="@style/KidsText.Body"
            android:visibility="gone" />
    </FrameLayout>
</LinearLayout>
