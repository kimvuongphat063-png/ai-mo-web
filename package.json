{
  "name": "digital-product-store",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "db:format": "prisma format",
    "db:validate": "prisma validate",
    "db:generate": "prisma generate",
    "db:seed": "tsx prisma/seed.ts",
    "test:promptkichban": "node --conditions=react-server --import tsx tests/promptkichban.ts",
    "test:promptkichban:docs": "node --conditions=react-server --import tsx tests/promptkichban-documents.ts",
    "test:promptkichban-docs": "node --conditions=react-server --import tsx tests/promptkichban-documents.ts",
    "test:library-e2e": "playwright test tests/promptkichban-library-e2e.spec.ts",
    "test:platform": "playwright test tests/platform-smoke.spec.ts",
    "promptkichban:verify-pg": "tsx scripts/verify-promptkichban-pg.ts",
    "test:gemini": "node --conditions=react-server --import tsx scripts/test-gemini-live.ts",
    "test:vietapi": "node --conditions=react-server --import tsx scripts/test-vietapi-live.ts",
    "benchmark:promptkichban": "node --conditions=react-server --import tsx scripts/benchmark-promptkichban.ts",
    "test:live-browser": "playwright test tests/promptkichban-live.spec.ts",
    "test": "tsx tests/unit.ts",
    "test:server": "node --conditions=react-server --import tsx tests/server/usage-adapter.ts && node --conditions=react-server --import tsx tests/server/rate-limit.ts",
    "test:smoke": "playwright test",
    "env:validate": "tsx scripts/validate-env.ts",
    "predeploy": "npm run env:validate && npm run typecheck && npm run build",
    "studio:readiness": "tsx scripts/test-studio-migration.ts && tsx tests/migration-regression.ts && tsx tests/delete-cascade-regression.ts",
    "studio:delete-check": "tsx tests/delete-cascade-regression.ts",
    "studio:migrate": "tsx scripts/migrate-studio-to-pg.ts",
    "studio:migrate:apply": "tsx scripts/migrate-studio-to-pg.ts --apply",
    "studio:verify": "tsx scripts/verify-studio-pg.ts"
  },
  "dependencies": {
    "@auth/prisma-adapter": "^2.11.2",
    "@node-rs/argon2": "^2.2.0",
    "@prisma/adapter-pg": "^7.8.0",
    "@prisma/client": "^7.8.0",
    "@react-email/components": "^1.0.12",
    "@sentry/nextjs": "^10.67.0",
    "@supabase/supabase-js": "^2.105.4",
    "@tailwindcss/typography": "^0.5.19",
    "@upstash/ratelimit": "^2.0.5",
    "@upstash/redis": "^1.34.4",
    "@vercel/analytics": "^1.4.1",
    "@vercel/speed-insights": "^1.1.0",
    "file-type": "^19.6.0",
    "highlight.js": "^11.11.1",
    "lucide-react": "^0.469.0",
    "next": "16.2.3",
    "next-auth": "^5.0.0-beta.31",
    "pg": "^8.20.0",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "react-email": "^6.9.0",
    "react-markdown": "^10.1.0",
    "rehype-highlight": "^7.0.2",
    "rehype-sanitize": "^6.0.0",
    "remark-gfm": "^4.0.1",
    "resend": "^4.0.1",
    "server-only": "^0.0.1",
    "sharp": "^0.33.5",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.61.1",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/pg": "^8.20.0",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "dotenv": "^17.4.2",
    "eslint": "^9",
    "eslint-config-next": "16.2.3",
    "prettier": "^3.6.2",
    "prisma": "^7.8.0",
    "tailwindcss": "^4",
    "tsx": "^4.19.2",
    "typescript": "^5"
  },
  "engines": {
    "node": ">=20"
  }
}
