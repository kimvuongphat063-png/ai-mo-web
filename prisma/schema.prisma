generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum UserStatus {
  active
  blocked
}

enum ProductStatus {
  draft
  published
  archived
}

enum OrderStatus {
  pending
  awaiting_confirmation
  paid
  cancelled
  refunded
  expired
}

enum LicenseType {
  personal
  team
  commercial
  extended
}

enum ReviewStatus {
  pending
  published
  hidden
}

enum ReferralStatus {
  pending
  confirmed
  rejected
}

enum PayoutStatus {
  pending
  processing
  paid
  failed
  cancelled
}

enum CouponType {
  percent
  fixed
}

enum AuditAction {
  create
  update
  delete
  confirm
  reject
  revoke
  download_revoke
  admin_grant
  admin_revoke
  payout_create
  payout_complete
}

model User {
  id              String               @id @default(cuid())
  name            String?
  email           String               @unique
  emailVerified   DateTime?
  image           String?
  status          UserStatus           @default(active)
  isAdmin         Boolean              @default(false)
  referralCode    String?              @unique
  // Phase 5A — auth hardening: Argon2id hash, never plaintext.
  passwordHash    String?
  // Bumped on password change/reset; embedded in session token as `v`.
  // Mismatch invalidates all prior sessions (stateless revocation).
  passwordVersion Int                  @default(0)
  createdAt       DateTime             @default(now())
  updatedAt       DateTime             @updatedAt
  deletedAt       DateTime?
  accounts        Account[]
  sessions        Session[]
  orders          Order[]
  reviews         Review[]
  referrals       Referral[]           @relation("ReferrerReferrals")
  confirmedRefs   Referral[]           @relation("ReferralConfirmer")
  payouts         Payout[]             @relation("PayoutRecipient")
  processedFunds  Payout[]             @relation("PayoutProcessor")
  auditLogs       AuditLog[]
  couponUsages    CouponUsage[]
  resetTokens     PasswordResetToken[]
  promptKichBanDocs PromptKichBanDocument[]

  @@index([status, deletedAt])
}

// Phase 5A — single-use password reset tokens. Only the SHA-256 hash of the
// raw token is stored; the raw value is emailed once and never persisted.
model PasswordResetToken {
  id        String    @id @default(cuid())
  userId    String
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

model Account {
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@id([provider, providerAccountId])
  @@index([userId])
}

model Session {
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@index([userId])
}

model VerificationToken {
  identifier String
  token      String
  expires    DateTime

  @@id([identifier, token])
}

model Category {
  id          String     @id @default(cuid())
  slug        String     @unique
  name        String
  description String?
  icon        String?
  order       Int        @default(0)
  parentId    String?
  parent      Category?  @relation("CategoryTree", fields: [parentId], references: [id], onDelete: SetNull)
  children    Category[] @relation("CategoryTree")
  products    Product[]
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
  deletedAt   DateTime?

  @@index([parentId, order])
  @@index([deletedAt])
}

model Product {
  id               String           @id @default(cuid())
  slug             String           @unique
  title            String
  shortDescription String?
  longDescription  String?
  coverImage       String?
  gallery          String[]
  categoryId       String?
  category         Category?        @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  tags             String[]
  status           ProductStatus    @default(draft)
  featured         Boolean          @default(false)
  basePrice        Int
  salesCount       Int              @default(0)
  ratingAvg        Float?
  ratingCount      Int              @default(0)
  metaTitle        String?
  metaDescription  String?
  ogImage          String?
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt
  publishedAt      DateTime?
  deletedAt        DateTime?
  variants         ProductVariant[]
  assets           ProductAsset[]
  reviews          Review[]
  orderItems       OrderItem[]

  @@index([status, featured, createdAt])
  @@index([categoryId, status])
  @@index([deletedAt])
}

model ProductVariant {
  id             String                @id @default(cuid())
  productId      String
  code           String
  name           String
  description    String?
  price          Int
  comparePrice   Int?
  licenseType    LicenseType
  maxDownloads   Int?
  downloadExpiry Int?
  available      Boolean               @default(true)
  order          Int                   @default(0)
  createdAt      DateTime              @default(now())
  updatedAt      DateTime              @updatedAt
  deletedAt      DateTime?
  product        Product               @relation(fields: [productId], references: [id], onDelete: Restrict)
  orderItems     OrderItem[]
  assetMappings  ProductAssetVariant[]

  @@unique([productId, code])
  @@index([productId, available])
  @@index([deletedAt])
}

model ProductAsset {
  id              String                @id @default(cuid())
  productId       String
  name            String
  filename        String
  storagePath     String                @unique
  sizeBytes       BigInt
  mimeType        String
  checksumSha256  String
  order           Int                   @default(0)
  createdAt       DateTime              @default(now())
  updatedAt       DateTime              @updatedAt
  deletedAt       DateTime?
  product         Product               @relation(fields: [productId], references: [id], onDelete: Restrict)
  variantMappings ProductAssetVariant[]
  downloadTokens  DownloadToken[]

  @@index([productId, deletedAt])
}

model ProductAssetVariant {
  assetId   String
  variantId String
  asset     ProductAsset   @relation(fields: [assetId], references: [id], onDelete: Restrict)
  variant   ProductVariant @relation(fields: [variantId], references: [id], onDelete: Restrict)

  @@id([assetId, variantId])
  @@index([variantId])
}

model Order {
  id             String          @id @default(cuid())
  publicCode     String          @unique
  userId         String?
  user           User?           @relation(fields: [userId], references: [id], onDelete: SetNull)
  buyerName      String
  buyerEmail     String
  buyerPhone     String?
  subtotal       Int
  discount       Int             @default(0)
  total          Int
  status         OrderStatus     @default(pending)
  paymentMemo    String          @unique
  paidAt         DateTime?
  paidBy         String?
  cancelledAt    DateTime?
  expiresAt      DateTime
  couponCode     String?
  referralCode   String?
  ipAddress      String?
  userAgent      String?
  note           String?
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  deletedAt      DateTime?
  items          OrderItem[]
  downloadTokens DownloadToken[]
  referral       Referral?
  couponUsage    CouponUsage?
  reviews        Review[]

  @@index([userId, status, createdAt])
  @@index([status, expiresAt])
  @@index([buyerEmail])
  @@index([deletedAt])
}

model OrderItem {
  id               String          @id @default(cuid())
  orderId          String
  productId        String
  variantId        String
  productTitleSnap String
  variantNameSnap  String
  priceSnap        Int
  licenseSnap      LicenseType
  maxDownloadsSnap Int?
  expiryDaysSnap   Int?
  createdAt        DateTime        @default(now())
  order            Order           @relation(fields: [orderId], references: [id], onDelete: Restrict)
  product          Product         @relation(fields: [productId], references: [id], onDelete: Restrict)
  variant          ProductVariant  @relation(fields: [variantId], references: [id], onDelete: Restrict)
  downloadTokens   DownloadToken[]

  @@index([orderId])
  @@index([productId])
  @@index([variantId])
}

model DownloadToken {
  id             String       @id @default(cuid())
  token          String       @unique
  orderId        String
  orderItemId    String
  assetId        String
  downloadCount  Int          @default(0)
  maxDownloads   Int
  expiresAt      DateTime
  lastDownloadAt DateTime?
  lastIpHash     String?
  revoked        Boolean      @default(false)
  revokedReason  String?
  createdAt      DateTime     @default(now())
  order          Order        @relation(fields: [orderId], references: [id], onDelete: Restrict)
  orderItem      OrderItem    @relation(fields: [orderItemId], references: [id], onDelete: Restrict)
  asset          ProductAsset @relation(fields: [assetId], references: [id], onDelete: Restrict)

  @@index([orderId])
  @@index([orderItemId])
  @@index([assetId])
  @@index([expiresAt, revoked])
}

model Coupon {
  id             String        @id @default(cuid())
  code           String        @unique
  description    String?
  type           CouponType
  value          Int
  minOrderAmount Int?
  maxDiscount    Int?
  usageLimit     Int?
  usageCount     Int           @default(0)
  perUserLimit   Int?
  productIds     String[]
  startsAt       DateTime?
  expiresAt      DateTime?
  active         Boolean       @default(true)
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
  deletedAt      DateTime?
  usages         CouponUsage[]

  @@index([code, active])
  @@index([deletedAt])
}

model CouponUsage {
  id        String   @id @default(cuid())
  couponId  String
  orderId   String   @unique
  userId    String?
  discount  Int
  createdAt DateTime @default(now())
  coupon    Coupon   @relation(fields: [couponId], references: [id], onDelete: Restrict)
  order     Order    @relation(fields: [orderId], references: [id], onDelete: Restrict)
  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([couponId, userId])
}

model Review {
  id               String       @id @default(cuid())
  productId        String
  userId           String
  orderId          String?
  rating           Int
  title            String?
  body             String?
  verifiedPurchase Boolean      @default(false)
  status           ReviewStatus @default(pending)
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt
  deletedAt        DateTime?
  product          Product      @relation(fields: [productId], references: [id], onDelete: Restrict)
  user             User         @relation(fields: [userId], references: [id], onDelete: Restrict)
  order            Order?       @relation(fields: [orderId], references: [id], onDelete: SetNull)

  @@unique([productId, userId])
  @@index([productId, status])
  @@index([orderId])
  @@index([deletedAt])
}

model Referral {
  id           String         @id @default(cuid())
  referrerId   String
  referralCode String
  orderId      String?        @unique
  buyerName    String
  buyerEmail   String?
  buyerPhone   String?
  amount       Int
  commission   Int
  status       ReferralStatus @default(pending)
  note         String?
  createdAt    DateTime       @default(now())
  confirmedAt  DateTime?
  confirmedBy  String?
  referrer     User           @relation("ReferrerReferrals", fields: [referrerId], references: [id], onDelete: Restrict)
  confirmer    User?          @relation("ReferralConfirmer", fields: [confirmedBy], references: [id], onDelete: SetNull)
  order        Order?         @relation(fields: [orderId], references: [id], onDelete: SetNull)
  payoutItems  PayoutItem[]

  @@index([referrerId, status])
  @@index([status, createdAt])
  @@index([confirmedBy])
}

model Payout {
  id            String       @id @default(cuid())
  publicCode    String       @unique
  recipientId   String
  processedById String?
  amount        Int
  status        PayoutStatus @default(pending)
  method        String?
  accountName   String?
  accountRef    String?
  transactionId String?
  note          String?
  requestedAt   DateTime     @default(now())
  processedAt   DateTime?
  paidAt        DateTime?
  updatedAt     DateTime     @updatedAt
  recipient     User         @relation("PayoutRecipient", fields: [recipientId], references: [id], onDelete: Restrict)
  processor     User?        @relation("PayoutProcessor", fields: [processedById], references: [id], onDelete: SetNull)
  items         PayoutItem[]

  @@index([recipientId, status])
  @@index([status, requestedAt])
  @@index([processedById])
}

model PayoutItem {
  payoutId   String
  referralId String   @unique
  amount     Int
  payout     Payout   @relation(fields: [payoutId], references: [id], onDelete: Restrict)
  referral   Referral @relation(fields: [referralId], references: [id], onDelete: Restrict)

  @@id([payoutId, referralId])
}

model LegalPage {
  id              String    @id @default(cuid())
  slug            String    @unique
  title           String
  summary         String?
  content         String
  version         String
  published       Boolean   @default(false)
  effectiveAt     DateTime?
  metaTitle       String?
  metaDescription String?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  publishedAt     DateTime?
  deletedAt       DateTime?

  @@index([published, effectiveAt])
  @@index([deletedAt])
}

model AuditLog {
  id         String      @id @default(cuid())
  userId     String?
  action     AuditAction
  entityType String
  entityId   String
  metadata   Json
  ipAddress  String?
  createdAt  DateTime    @default(now())
  user       User?       @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([entityType, entityId])
  @@index([userId, createdAt])
}

// ─────────────────────────────────────────────────────────────────────────────
// AI MỞ STUDIO MIGRATION (Phase 4A)
// ─────────────────────────────────────────────────────────────────────────────

model StudioBrandProfile {
  userId              String   @id
  companyName         String?
  brandVoice          String?
  prohibitedClaims    String?
  requiredDisclosures String?
  preferredFormats    String[]
  targetAudience      String?
  competitorUrls      String[]
  language            String   @default("vi")
  updatedAt           DateTime @updatedAt
}

model StudioProduct {
  id                  String         @id @default(cuid())
  userId              String
  name                String
  url                 String?
  description         String
  priceOffer          String?
  featuresText        String
  targetCustomer      String
  problemSolved       String
  allowedProof        String?
  claimsToAvoid       String?
  affiliateLink       String?
  brandVoice          String?
  analysisCache       Json?
  analysisFingerprint String?
  createdAt           DateTime       @default(now())
  updatedAt           DateTime       @updatedAt
  deletedAt           DateTime?
  scripts             StudioScript[]

  @@index([userId])
  @@index([deletedAt])
}

model StudioScript {
  id                 String                    @id @default(cuid())
  userId             String
  productProfileId   String
  platform           String
  goal               String
  durationSeconds    Int
  selectedAngleId    String
  scripts            Json
  missingInformation String[]
  complianceNotes    String[]
  createdAt          DateTime                  @default(now())
  updatedAt          DateTime                  @updatedAt
  deletedAt          DateTime?
  product            StudioProduct             @relation(fields: [productProfileId], references: [id], onDelete: Cascade)
  campaignItems      StudioCampaignItem[]
  performanceMetrics StudioPerformanceMetric[]

  @@index([userId])
  @@index([productProfileId])
  @@index([deletedAt])
}

model StudioCampaign {
  id                 String                    @id @default(cuid())
  userId             String
  name               String
  startDate          DateTime
  durationDays       Int
  platform           String
  goal               String
  createdAt          DateTime                  @default(now())
  updatedAt          DateTime                  @updatedAt
  deletedAt          DateTime?
  items              StudioCampaignItem[]
  performanceMetrics StudioPerformanceMetric[]

  @@index([userId])
  @@index([deletedAt])
}

model StudioCampaignItem {
  id           String         @id @default(cuid())
  campaignId   String
  day          Int
  scriptId     String?
  status       String
  publishedUrl String?
  notes        String?
  campaign     StudioCampaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  script       StudioScript?  @relation(fields: [scriptId], references: [id], onDelete: SetNull)

  @@unique([campaignId, day])
  @@index([scriptId])
}

model StudioPerformanceMetric {
  id               String          @id @default(cuid())
  userId           String
  scriptId         String
  campaignId       String?
  recordedAt       DateTime
  views            Int             @default(0)
  likes            Int             @default(0)
  comments         Int             @default(0)
  shares           Int             @default(0)
  clicks           Int             @default(0)
  conversions      Int             @default(0)
  revenue          Float           @default(0)
  costSpent        Float           @default(0)
  watchTimeSeconds Int             @default(0)
  engagementRate   Float           @default(0)
  ctr              Float           @default(0)
  roas             Float           @default(0)
  script           StudioScript    @relation(fields: [scriptId], references: [id], onDelete: Cascade)
  campaign         StudioCampaign? @relation(fields: [campaignId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([scriptId])
  @@index([campaignId])
}

model StudioAiUsage {
  id     String @id @default(cuid())
  userId String
  day    String // YYYY-MM-DD
  count  Int    @default(0)

  @@unique([userId, day])
}

model StudioGenerationJob {
  id        String   @id @default(cuid())
  userId    String
  status    String   @default("pending") // pending, running, complete, failed
  prompt    Json?
  result    Json?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId, status])
}

// Phase 4 — PromptKichBan Authenticated Documents & Library
model PromptKichBanDocument {
  id                 String    @id @default(cuid())
  userId             String
  title              String
  inputSnapshot      Json
  outputSnapshot     Json
  provider           String
  model              String
  durationSeconds    Int
  aspectRatio        String
  publishingPlatform String
  contentType        String
  status             String    @default("saved") // saved, draft, archived
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt
  deletedAt          DateTime?

  user               User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([userId, deletedAt])
  @@index([deletedAt])
}
